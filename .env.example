# Supabase PostgreSQL. Use the pooler URL for the running app.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Required for password-reset email in production. Optional in development,
# where the reset URL is printed in the server terminal.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Paper Ledger <ledger@example.com>
