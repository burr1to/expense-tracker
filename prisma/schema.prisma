generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                    @id @default(cuid())
  name              String
  email             String                    @unique
  emailVerified     Boolean                   @default(false)
  image             String?
  currency          String                    @default("NPR")
  theme             String                    @default("system")
  hideAmounts       Boolean                   @default(false)
  autoLockMinutes   Int                       @default(0)
  calendarSystem    String                    @default("AD")
  safeToSpendBufferMinor Int                  @default(0)
  emailReminders    Boolean                   @default(false)
  browserReminders  Boolean                   @default(false)
  lastReminderEmailOn DateTime?               @db.Date
  pinHash           String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  sessions          Session[]
  accounts          Account[]
  paymentAccounts   PaymentAccount[]
  reconciliations   AccountReconciliation[]
  transfers         AccountTransfer[]
  transactions      Transaction[]
  budgets           Budget[]
  recurring         RecurringEntry[]
  goals             SavingsGoal[]
  goalContributions SavingsGoalContribution[]
  categories        CustomCategory[]
  subcategories     CustomSubcategory[]
  dueItems          DueItem[]
  duePayments       DuePayment[]
  receipts          ReceiptAttachment[]
  receiptScans      ReceiptScan[]
  savedPlaces       SavedPlace[]
  recovery          AccountRecovery?
  importJobs        ImportJob[]
  learningProfile   LearningProfile?
  householdMembership HouseholdMember?
  activityLogs      ActivityLog[]
  aiUsage           AiUsage[]
}

model Household {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  members   HouseholdMember[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String?   @unique
  email       String    @unique
  name        String    @default("")
  role        String
  status      String
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId])
}

model LearningProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  enabled                 Boolean  @default(false)
  suggestions             Json     @default("[]")
  summary                 String[] @default([])
  lastCreatedAt           DateTime?
  lastTransactionId       String?
  lastRunAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AccountRecovery {
  id               String   @id @default(cuid())
  userId           String   @unique
  questionOneKey   String
  questionOneHash  String
  questionTwoKey   String
  questionTwoHash  String
  recoveryCodeHash String
  failedAttempts   Int      @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                String             @id @default(cuid())
  userId            String
  kind              String
  category          String
  amountMinor       Int
  occurredOn        DateTime           @db.Date
  note              String             @default("")
  subcategory       String?
  area              String?
  paymentMode       String             @default("cash")
  paymentAccountId  String?
  locationLabel     String?
  locationAddress   String?
  locationLatitude  Float?
  locationLongitude Float?
  locationAccuracy  Int?
  locationSource    String?
  savedPlaceId      String?
  receiptScanId     String?
  importJobId       String?
  shared            Boolean            @default(false)
  clientRequestId   String?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount    PaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  savedPlace        SavedPlace?        @relation(fields: [savedPlaceId], references: [id], onDelete: SetNull)
  receipt           ReceiptAttachment?
  receiptScan       ReceiptScan?       @relation(fields: [receiptScanId], references: [id], onDelete: SetNull)
  importJob         ImportJob?        @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, occurredOn])
  @@index([userId, deletedAt])
  @@index([paymentAccountId])
  @@index([savedPlaceId])
  @@index([receiptScanId])
  @@index([importJobId])
}

/// Append-only record of what a user did. Written by the server after an action succeeds; never edited.
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  area        String
  entityId    String?
  title       String
  subject     String?
  amountMinor Int?
  currency    String   @default("NPR")
  changes     Json?
  meta        Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, area, createdAt(sort: Desc)])
}

model ImportJob {
  id                    String        @id @default(cuid())
  userId                String
  status                String        @default("queued")
  totalRows             Int
  processedRows         Int           @default(0)
  payload               Json
  createdCategoryIds    String[]      @default([])
  createdSubcategoryIds String[]      @default([])
  error                 String?
  lockExpiresAt         DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]

  @@index([userId, status])
}

model SavedPlace {
  id           String        @id @default(cuid())
  userId       String
  name         String
  icon         String        @default("pin")
  address      String        @default("Kathmandu, Nepal")
  latitude     Float
  longitude    Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastUsedAt   DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, lastUsedAt])
}

model PaymentAccount {
  id                String            @id @default(cuid())
  importId          String            @default(dbgenerated("gen_random_uuid()::text"))
  userId            String
  type              String
  provider          String
  label             String            @default("")
  accountTail       String?
  shared            Boolean           @default(false)
  balanceMinor      Int               @default(0)
  balanceAsOf       DateTime          @default(now()) @db.Date
  balanceRecordedAt DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reconciliations   AccountReconciliation[]
  transactions      Transaction[]
  recurringEntries   RecurringEntry[]
  outgoingTransfers AccountTransfer[] @relation("TransferFrom")
  incomingTransfers AccountTransfer[] @relation("TransferTo")

  @@index([userId])
  @@unique([userId, importId])
}

model AccountReconciliation {
  id                      String         @id @default(cuid())
  userId                  String
  paymentAccountId        String
  monthKey                String
  checkedOn               DateTime       @db.Date
  startingBalanceMinor    Int
  startingBalanceAsOf     DateTime       @db.Date
  incomeMinor             Int
  expenseMinor            Int
  transfersInMinor        Int
  transfersOutMinor       Int
  expectedBalanceMinor    Int
  actualBalanceMinor      Int
  adjustmentMinor         Int
  adjustmentNote          String         @default("")
  approvedAt              DateTime       @default(now())
  createdAt               DateTime       @default(now())
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount          PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)

  @@unique([paymentAccountId, monthKey])
  @@index([userId, approvedAt])
}

model AccountTransfer {
  id            String         @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amountMinor   Int
  occurredOn    DateTime       @db.Date
  note          String         @default("")
  clientRequestId String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   PaymentAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     PaymentAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, occurredOn])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  monthKey    String
  scope       String   @default("month")
  category    String
  amountMinor Int
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey, category])
}

model RecurringEntry {
  id                 String   @id @default(cuid())
  userId             String
  kind               String
  category           String
  amountMinor        Int
  paymentAccountId   String?
  note               String   @default("")
  tags               String[] @default([])
  dayOfMonth         Int?
  recurrenceUnit     String   @default("month")
  recurrenceInterval Int      @default(1)
  anchorDate         DateTime @db.Date
  nextDueOn          DateTime @db.Date
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount     PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  @@index([userId, nextDueOn])
  @@index([paymentAccountId])
}

model SavingsGoal {
  id            String                    @id @default(cuid())
  userId        String
  name          String
  targetMinor   Int
  savedMinor    Int                       @default(0)
  targetDate    DateTime?                 @db.Date
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsGoalContribution[]

  @@index([userId])
}

model SavingsGoalContribution {
  id               String      @id @default(cuid())
  userId           String
  goalId           String
  amountMinor      Int
  isOpeningBalance Boolean     @default(false)
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId, createdAt])
}

model CustomCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      String
  color     String
  icon      String   @default("tag")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model CustomSubcategory {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  name       String
  icon       String   @default("tag")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, name])
  @@index([userId, categoryId])
}

model DueItem {
  id           String             @id @default(cuid())
  userId       String
  kind         String
  title        String
  person       String             @default("")
  amountMinor  Int
  category     String
  occurredOn   DateTime?          @db.Date
  dueOn        DateTime           @db.Date
  remindOn     DateTime?          @db.Date
  snoozedUntil DateTime?          @db.Date
  note         String             @default("")
  status       String             @default("open")
  annualRatePercent Float?
  completedOn  DateTime?          @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     DuePayment[]
  receipt      ReceiptAttachment?

  @@index([userId, dueOn])
  @@index([userId, remindOn])
  @@index([userId, snoozedUntil])
}

model DuePayment {
  id            String   @id @default(cuid())
  userId        String
  dueItemId     String
  amountMinor   Int
  occurredOn    DateTime @db.Date
  note          String   @default("")
  transactionId String?
  clientRequestId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueItem       DueItem  @relation(fields: [dueItemId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, dueItemId])
  @@index([dueItemId])
}

model ReceiptAttachment {
  id            String       @id @default(cuid())
  userId        String
  transactionId String?      @unique
  dueItemId     String?      @unique
  name          String
  mimeType      String
  size          Int
  storagePath   String?      @unique
  data          Bytes?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  dueItem       DueItem?     @relation(fields: [dueItemId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReceiptScan {
  id           String        @id @default(cuid())
  userId       String
  name         String
  mimeType     String
  size         Int
  storagePath  String        @unique
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// Daily Gemini usage per user and feature, so one account cannot drain the shared AI quota.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  feature   String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, feature])
}
